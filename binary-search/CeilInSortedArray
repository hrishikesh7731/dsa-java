class Solution {
    public int findCeil(int[] arr, int x) {
        
        int l=0,r=arr.length-1,idx=-1;
        
        while(l<=r){
            
            int mid=l+(r-l)/2;
            
            if(arr[mid]>=x){
                idx=mid;
                r=mid-1;
            }
            else{
                l=mid+1;
            }
        }
        return idx;
    }
}
