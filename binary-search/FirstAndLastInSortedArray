class Solution {
    ArrayList<Integer> find(int arr[], int x) {
        
        ArrayList<Integer>ans=new ArrayList<>();
        int p1=firstPos(arr,x);
        int p2=secondPos(arr,x);
        ans.add(p1);
        ans.add(p2);
        return ans;
    }
    
    public int firstPos(int[] arr,int x){
        int l=0,r=arr.length-1,pos1=-1;
            
        while(l<=r){
            int mid=l+(r-l)/2;
                
            if (arr[mid] == x) {
                pos1 = mid;
                r = mid - 1;
            } 
            else if (arr[mid] < x) {
                l = mid + 1;
            } 
            else{
                r = mid - 1;
            }
        }
        return pos1;
    }
        
    public int secondPos(int[]arr,int x){
        int l=0,r=arr.length-1,pos2=-1;
            
        while(l<=r){
            int mid=l+(r-l)/2;
            
            if (arr[mid] == x) {
                pos2 = mid;
                l = mid + 1;
            } 
            else if (arr[mid] < x) {
                l = mid + 1;
            } 
            else {
                r = mid - 1;
            }
        }
        return pos2;
    }
    
}
