class Solution {
    public String isValid(String s,String ans,int i,int j){
        while(i>=0 && j<s.length() && s.charAt(i)==s.charAt(j)){
            i--;
            j++;
        }
        if(j-i>ans.length()){
            ans=s.substring(i+1,j);
        }
        return ans;
    }
    public String longestPalindrome(String s) {
        String ans="";
        for(int i=0;i<s.length();i++){
           ans= isValid(s,ans,i,i);
           ans= isValid(s,ans,i,i+1);
        }
        return ans;
    }
}
