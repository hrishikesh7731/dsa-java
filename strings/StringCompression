class Solution {
    public int compress(char[] chars) {
        
        int n=chars.length;
        int i=0,idx=0;

        while(i<n){

            int count=0;
            char curr=chars[i];

            while(i<n && chars[i]==curr){
                count++;
                i++;
            }
            chars[idx]=curr;
            idx++;

            if(count>1){
                String countStr = String.valueOf(count);
                for(char ch : countStr.toCharArray()){
                    chars[idx]=ch;
                    idx++;
                }
            }
        }
        return idx;
    }
}
