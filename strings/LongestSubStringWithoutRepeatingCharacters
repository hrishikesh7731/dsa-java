class Solution {
    public int longestUniqueSubstr(String s) {
        
        HashMap<Character,Integer>map = new HashMap<>();
        int len=0,left=0;
        
        for(int i=0; i<s.length(); i++){
            
            char ch= s.charAt(i);
            
            if(map.containsKey(ch)){
                left = Math.max(left, map.get(ch) + 1);
            }
            map.put(ch,i);
            
            len= Math.max(len,i-left+1);
        }
        
        return len;
    }
}
